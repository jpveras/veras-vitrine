# Copie este arquivo para .env.local (no seu computador) e preencha.
# Na Vercel, cadastre os mesmos nomes em Settings > Environment Variables.
# NUNCA publique estes valores em chat, GitHub ou prints.

# Supabase: deixe estas duas linhas COMENTADAS (com #) para rodar só local.
# Só descomente quando for usar o banco na Vercel. (Project Settings > API)
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=coloque_a_service_role_key_aqui

# Telegram
TELEGRAM_BOT_TOKEN=token_que_o_BotFather_deu
# Invente uma senha longa (só letras e números, até 64 caracteres). O Telegram a envia em cada chamada.
TELEGRAM_WEBHOOK_SECRET=invente_uma_senha_longa_aqui
TELEGRAM_CHANNEL_USERNAME=PromocoesdoVeras

# Endereço público do site (usado só pelo script que liga o bot ao site)
SITE_URL=https://www.promocoesdoveras.com.br
